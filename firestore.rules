rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }

    function isPoliceOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'police' || getUserRole() == 'admin');
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if true; // Public read for officer verification, citizen lookup, and login detection
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isPoliceOrAdmin();
      allow delete: if isPoliceOrAdmin();
    }

    // 2. COMPLAINTS (CSR)
    match /complaints/{complaintId} {
      allow read: if true; // Public read for tracking and safety feeds
      allow create: if isAuthenticated();
      allow update, delete: if isPoliceOrAdmin() || isAuthenticated();
    }

    // 3. COMPREHENSIVE FIR INCIDENTS
    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isPoliceOrAdmin() || isAuthenticated();
    }

    // 4. FIR SUB-DATA
    match /offences/{id} { allow read, write: if true; }
    match /evidence/{id} { allow read, write: if isAuthenticated(); }
    match /witnesses/{id} { allow read, write: if isAuthenticated(); }
    match /statements/{id} { allow read, write: if isAuthenticated(); }
    match /officer_reviews/{id} { allow read, write: if isAuthenticated(); }

    // 5. EMERGENCY SOS ALERTS
    match /sos_alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }

    // 6. INVESTIGATION TIMELINE & CASE LOGS
    match /case_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // 7. TAXONOMY (Categories, Departments, Areas)
    match /categories/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /departments/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /areas/{id} { allow read: if true; allow write: if isAuthenticated(); }
  }
}
