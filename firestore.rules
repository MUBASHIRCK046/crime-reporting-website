rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS CONTROL (RBAC)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPolice() {
      return isAuthenticated() && getUserData().role == 'police';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isPoliceOrAdmin() {
      return isAuthenticated() && (getUserData().role in ['police', 'admin']);
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      // Authenticated users can view profiles (e.g. Police viewing citizen KYC)
      allow read: if isAuthenticated();
      
      // Users can only create their own user document upon registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own details (phone, address, KYC docs), Admins can update any user/role
      allow update: if isOwner(userId) || isAdmin();
      
      // Only system admins can delete user records
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. COMPLAINTS (CSR / SIMPLE COMPLAINTS)
    // =========================================================================
    match /complaints/{complaintId} {
      // Citizen can view their own, Police/Admin can view all, Public can view broadcasted alerts
      allow read: if isAuthenticated() && (
        resource.data.citizenId == request.auth.uid || 
        isPoliceOrAdmin() || 
        resource.data.isBroadcasted == true
      );
      
      // Authenticated citizens can file complaints under their own UID
      allow create: if isAuthenticated() && request.resource.data.citizenId == request.auth.uid;
      
      // Status updates, case assignments, and verification only permitted for Police and Admins
      allow update, delete: if isPoliceOrAdmin();
    }

    // =========================================================================
    // 3. COMPREHENSIVE FIR INCIDENTS
    // =========================================================================
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        resource.data.complainantId == request.auth.uid || 
        isPoliceOrAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.complainantId == request.auth.uid;
      allow update, delete: if isPoliceOrAdmin();
    }

    // =========================================================================
    // 4. FIR SUB-DATA (Offences, Evidence, Witnesses, Statements)
    // =========================================================================
    match /offences/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPoliceOrAdmin();
    }

    match /evidence/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isPoliceOrAdmin();
    }

    match /witnesses/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPoliceOrAdmin();
    }

    match /statements/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPoliceOrAdmin();
    }

    match /officer_reviews/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPoliceOrAdmin();
    }

    // =========================================================================
    // 5. EMERGENCY SOS ALERTS
    // =========================================================================
    match /sos_alerts/{alertId} {
      // Police monitor all SOS alerts, citizens can view their active distress signal
      allow read: if isAuthenticated() && (
        resource.data.citizenId == request.auth.uid || 
        isPoliceOrAdmin()
      );
      
      // Citizens can trigger emergency alerts with their own UID
      allow create: if isAuthenticated() && request.resource.data.citizenId == request.auth.uid;
      
      // Only Police/Admin can resolve active emergency alerts
      allow update, delete: if isPoliceOrAdmin();
    }

    // =========================================================================
    // 6. INVESTIGATION TIMELINE & CASE LOGS
    // =========================================================================
    match /case_logs/{logId} {
      // Citizens can read logs for their cases, Police/Admin can read all
      allow read: if isAuthenticated();
      
      // Only Police officers or Admins can record case logs
      allow create, update, delete: if isPoliceOrAdmin();
    }

    // =========================================================================
    // 7. TAXONOMY & CONFIGURATION (Categories, Departments, Areas)
    // =========================================================================
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /areas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
